# ---------------------------------------------------------------------------
# 环境变量样例。复制为 .env 后填写（.env 已被 .gitignore 排除，不会入库）
#
#   cp .env.example .env          # Linux / macOS
#   copy .env.example .env        # Windows CMD
#
# 优先级：环境变量 > config/default.yaml > 代码默认值
# 也就是说：这里留空的项会自动落回 config/default.yaml 的值，不必重复填写。
# ---------------------------------------------------------------------------

# ========== 生成模型（LLM） ==========
# mock = 离线抽取式假模型，零成本、确定性，用于验证检索与引用链路是否打通
# 真实供应商：openai / deepseek / qwen / moonshot / zhipu / ollama / vllm
LLM_PROVIDER=mock
LLM_API_KEY=
# 留空则使用该供应商的官方端点；自建网关/代理时填这里
LLM_BASE_URL=
# 留空则使用该供应商的默认模型
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ========== 向量模型（Embedding） ==========
# hash = 离线哈希向量，★只有词面相似度、没有语义，禁止上生产★
# 生产建议：openai / qwen / siliconflow（bge-m3）/ ollama
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=512
EMBEDDING_BATCH=16

# ========== 数据与索引路径（相对路径相对仓库根解析） ==========
POLICY_DOC_PATH=data/policy/员工薪酬变更核对制度_v1.0.md
INDEX_DIR=data/index

# ========== 切片 ==========
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=60
# size = 按 500 字装箱（默认）；clause = 一条一款
CHUNK_MODE=size

# ========== 检索 ==========
TOP_K=3
RECALL_K=12
RRF_K=60
W_VECTOR=1.0
W_BM25=1.0

# 拒答闸门：两路最高分都低于阈值即判定"库里没有依据"。
# ★ 换向量模型后必须重新标定，否则会"该答的不答"或"该拒的乱答"★
MIN_VECTOR_SCORE=0.25
MIN_BM25_SCORE=4.0

# 检索基准日期（模拟业务日期），留空 = 2026-06-01
AS_OF_DATE=

# ========== 鉴权（管理后台） ==========
# 1 = 必须登录（生产默认）；0 = 演示模式，所有访问按管理员处理，不做校验
# 关掉它只为了演示与回归测试，正式部署前务必打开
AUTH_REQUIRED=1

# JWT 签名密钥。留空则自动生成并保存到 AUTH_SECRET_FILE，
# 之后重启用同一个密钥（否则每次重启所有人都被踢下线）
AUTH_SECRET=
AUTH_SECRET_FILE=data/.auth_secret
JWT_TTL_HOURS=8
# 走 HTTPS 时置 1（Cookie 加 Secure）
COOKIE_SECURE=0

# 登录限流：同账号连续失败 N 次后锁 M 分钟
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=5

# 首次启动的种子管理员。密码留空则随机生成并打印到启动日志（只打印一次）
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# ========== 知识库上传 ==========
UPLOAD_DIR=data/policy/uploads
UPLOAD_MAX_MB=10

# ========== 提示词模板缓存 ==========
# 单 worker 下保存即生效；多 worker 下其他进程最长等这么久
PROMPT_CACHE_SECONDS=5

# 会话库路径（同时存用户、制度清单、提示词模板、审计标记）
CHAT_DB_PATH=data/chat.db
